# LLM Configuration
DEFAULT_MODEL=gemini/gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key


# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medical_db

# WhatsApp Cloud API Webhook Configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here
# Meta WhatsApp Cloud API (v21.0)
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_string
WHATSAPP_API_VERSION=v21.0
# WhatsApp Cloud API Outbound Configuration
WHATSAPP_API_TOKEN=your_whatsapp_system_user_token_here


# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical_agent_phase3